{
  "name": "i18nexus",
  "version": "4.0.1",
  "description": "Type-safe React i18n toolkit with intelligent automation and SSR support",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/utils/server.d.ts",
      "import": "./dist/utils/server.js",
      "default": "./dist/utils/server.js"
    },
    "./edge": {
      "types": "./dist/utils/edge.d.ts",
      "import": "./dist/utils/edge.js",
      "default": "./dist/utils/edge.js"
    },
    "./icu": {
      "types": "./dist/utils/icu.d.ts",
      "import": "./dist/utils/icu.js",
      "default": "./dist/utils/icu.js"
    },
    "./icu/server": {
      "types": "./dist/utils/icu-server.d.ts",
      "import": "./dist/utils/icu-server.js",
      "default": "./dist/utils/icu-server.js"
    },
    "./icu/formatter": {
      "types": "./dist/utils/icu-formatter.d.ts",
      "import": "./dist/utils/icu-formatter.js",
      "default": "./dist/utils/icu-formatter.js"
    },
    "./devtools": {
      "types": "./dist/components/I18NexusDevtools.d.ts",
      "import": "./dist/components/I18NexusDevtools.js",
      "default": "./dist/components/I18NexusDevtools.js"
    }
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "lint": "eslint src/**/*.{ts,tsx}",
    "lint:fix": "eslint src/**/*.{ts,tsx} --fix",
    "format": "prettier --write src/**/*.{ts,tsx}",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build",
    "smoke:pack": "node scripts/smoke-packed-package.mjs",
    "smoke:bundle": "node scripts/smoke-browser-bundle.mjs",
    "smoke:edge": "node scripts/smoke-edge-runtime.mjs",
    "benchmark:translation": "node scripts/benchmark-translation.mjs",
    "version": "(npm run format || true) && git add -A src || true",
    "postversion": "echo '✅ Version updated successfully'",
    "validate": "npm run build && npm run test",
    "publish:dry": "npm pack --dry-run",
    "publish:check": "npm run validate && npm run smoke:pack && npm run publish:dry"
  },
  "keywords": [
    "react",
    "i18n",
    "internationalization",
    "translation",
    "cookie",
    "google-sheets",
    "typescript",
    "babel",
    "ast"
  ],
  "author": "manNomi <hanmw110@naver.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manNomi/i18nexus.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/manNomi/i18nexus/issues"
  },
  "homepage": "https://github.com/manNomi/i18nexus/tree/main/packages/core#readme",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "dependencies": {
    "intl-messageformat": "11.2.13"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/parser": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.22.0",
    "@babel/preset-typescript": "^7.23.0",
    "@babel/traverse": "^7.23.0",
    "@eslint/js": "^9.36.0",
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/react": "^13.4.0",
    "@types/babel__generator": "^7.6.0",
    "@types/babel__traverse": "^7.20.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.8.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "babel-jest": "^29.7.0",
    "esbuild": "0.25.11",
    "@typescript-eslint/eslint-plugin": "^6.9.0",
    "@typescript-eslint/parser": "^6.9.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.0",
    "globals": "^16.4.0",
    "i18next": "^23.6.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^13.3.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.2.0",
    "typescript-eslint": "^8.44.1"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}
