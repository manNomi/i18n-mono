{
  "name": "i18nexus-tools",
  "version": "3.1.0",
  "description": "Core v4 companion CLI for i18nexus - wrap, extract, type, diagnose, and sync translations",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "i18n-wrapper": "dist/bin/i18n-wrapper.js",
    "i18n-wrapper-swc": "dist/bin/i18n-wrapper-swc.js",
    "i18n-wrapper-swc-worker": "dist/bin/i18n-wrapper-swc-worker.js",
    "i18n-extractor": "dist/bin/i18n-extractor.js",
    "i18n-type": "dist/bin/i18n-type.js",
    "i18n-upload": "dist/bin/i18n-upload.js",
    "i18n-download": "dist/bin/i18n-download.js",
    "i18n-download-force": "dist/bin/i18n-download-force.js",
    "i18n-sheets": "dist/bin/i18n-sheets.js",
    "i18n-clean-legacy": "dist/bin/i18n-clean-legacy.js",
    "i18n-doctor": "dist/bin/i18n-doctor.js"
  },
  "scripts": {
    "build": "npm run clean && tsc && npm run postbuild",
    "postbuild": "chmod +x dist/bin/*.js 2>/dev/null || true",
    "clean": "rm -rf dist",
    "pretest": "npm run build",
    "test": "jest --runInBand --no-watchman",
    "test:ci": "jest --runInBand --no-watchman --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings=0",
    "lint:fix": "eslint --fix",
    "smoke:pack": "node scripts/smoke-packed-package.mjs",
    "publish:check": "npm test && npm run smoke:pack && npm pack --dry-run",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "prepack": "npm run build"
  },
  "keywords": [
    "i18n",
    "cli",
    "internationalization",
    "translation",
    "react",
    "typescript",
    "google-sheets",
    "code-transformation",
    "automation",
    "next.js",
    "server-components",
    "i18next",
    "localization"
  ],
  "author": "manNomi <hanmw110@naver.com>",
  "license": "MIT",
  "engines": {
    "node": "22.x || 24.x || 26.x",
    "npm": ">=9.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@babel/generator": "^7.23.4",
    "@babel/parser": "^7.23.4",
    "@babel/traverse": "^7.23.4",
    "@babel/types": "^7.23.4",
    "@swc/core": "^1.15.1",
    "commander": "^11.1.0",
    "csv-parser": "^3.0.0",
    "csv-writer": "^1.6.0",
    "glob": "^10.3.10",
    "google-auth-library": "^9.4.0",
    "googleapis": "^129.0.0",
    "inquirer": "^13.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/babel__generator": "^7.6.7",
    "@types/babel__traverse": "^7.20.4",
    "@types/inquirer": "^9.0.9",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.9.4",
    "eslint": "^9.39.1",
    "globals": "^15.15.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.5",
    "typescript": "^5.3.2",
    "typescript-eslint": "^8.48.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/i18n-global/i18n-mono.git",
    "directory": "packages/tools"
  },
  "bugs": {
    "url": "https://github.com/i18n-global/i18n-mono/issues"
  },
  "homepage": "https://github.com/i18n-global/i18n-mono/tree/main/packages/tools#readme"
}
