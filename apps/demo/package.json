{
  "name": "i18nexus-demo",
  "version": "1.0.0",
  "description": "i18nexus Demo Application - Complete React i18n toolkit demonstration",
  "private": false,
  "main": "index.js",
  "scripts": {
    "prepare:local-packages": "node scripts/prepare-local-packages.mjs",
    "check:local-packages": "node scripts/check-local-packages.mjs",
    "prepare:local-tools": "npm --workspace i18nexus-tools run build",
    "assert:no-dev-server": "node scripts/assert-next-dev-stopped.mjs",
    "predev": "npm run prepare:local-packages && npm run check:local-packages",
    "dev": "next dev",
    "prebuild": "npm run assert:no-dev-server && npm run prepare:local-packages && npm run check:local-packages",
    "build": "next build",
    "build:safe": "npm run build",
    "typecheck": "tsc --noEmit",
    "validate": "npm run prepare:local-packages && npm run check:local-packages && npm run lint && npm run build",
    "start": "next start",
    "lint": "eslint",
    "export": "next export",
    "i18n:pull": "i18nexus pull",
    "i18n:import": "i18nexus import ./lib/translations/ko.json",
    "i18n:listen": "i18nexus listen",
    "prei18n:extract": "npm run prepare:local-tools",
    "i18n:extract": "node ../../packages/tools/dist/bin/i18n-extractor.js",
    "prei18n:type": "npm run prepare:local-tools",
    "i18n:type": "node ../../packages/tools/dist/bin/i18n-type.js && prettier --write locales/types/i18nexus.d.ts",
    "i18n:sync": "npm run i18n:extract && npm run i18n:type",
    "i18n:check": "node scripts/check-i18n-types.mjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prei18n:upload": "npm run prepare:local-tools",
    "i18n:upload": "node ../../packages/tools/dist/bin/i18n-upload.js",
    "prei18n:download": "npm run prepare:local-tools",
    "i18n:download": "node ../../packages/tools/dist/bin/i18n-download.js"
  },
  "dependencies": {
    "@vercel/analytics": "^1.5.0",
    "firebase": "^12.4.0",
    "i18next": "^25.5.2",
    "i18nexus": "file:../../packages/core",
    "next": "^15.5.9",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-ga4": "^2.1.0",
    "react-i18next": "^16.0.0",
    "react-syntax-highlighter": "^16.1.0",
    "tailwindcss": "^3.4.18"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^9",
    "eslint-config-next": "15.5.9",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^15.13.0",
    "i18nexus-tools": "file:../../packages/tools",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "null-loader": "^4.0.1",
    "postcss": "^8.4.32",
    "ts-jest": "^29.4.5",
    "typescript": "^5",
    "typescript-eslint": "^8.48.0"
  },
  "keywords": [
    "i18n",
    "internationalization",
    "react",
    "nextjs",
    "demo",
    "translation"
  ],
  "author": "manNomi <hanmw110@naver.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manNomi/i18nexus.git",
    "directory": "packages/i18nexus-demo"
  },
  "bugs": {
    "url": "https://github.com/manNomi/i18nexus/issues"
  },
  "homepage": "https://github.com/manNomi/i18nexus#readme"
}
